            "value" : "Je inlog bij Jellyseerr is verlopen."
          }
        }
      }
    },
    "Die Anmeldung konnte nicht sicher gespeichert werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in couldn't be stored securely."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta connexion n'a pas pu être enregistrée de façon sécurisée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar tu sesión de forma segura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare l'accesso in modo sicuro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je inlog kan niet veilig worden bewaard."
          }
        }
      }
    },
    "Die Datei konnte nicht geöffnet werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file couldn't be opened."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n'a pas pu être ouvert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido abrir el archivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire il file."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand kan niet worden geopend."
          }
        }
      }
    },
    "Die Datenschutzerklärung zum Lesen auf dem Handy: Code scannen oder die Adresse öffnen:\n\n%@\n\nDas Wichtigste steht auch hier darunter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To read the privacy policy on your phone, scan the code or open this address:\n\n%@\n\nThe key points are also summarized below."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lire la politique de confidentialité sur ton téléphone, scanne le code ou ouvre cette adresse :\n\n%@\n\nL'essentiel est aussi résumé ci-dessous."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para leer la política de privacidad en tu teléfono, escanea el código o abre esta dirección:\n\n%@\n\nAbajo también se resumen los puntos clave."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per leggere l'informativa sulla privacy sul telefono, scansiona il codice o apri questo indirizzo:\n\n%@\n\nI punti principali sono riassunti anche qui sotto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om het privacybeleid op je telefoon te lezen, scan je de code of open je dit adres:\n\n%@\n\nDe belangrijkste punten staan hieronder ook samengevat."
          }
        }
      }
    },
    "Die Geschwindigkeit schwankt stark (zeitweise nur %@ Mbit/s). Ein größerer Puffer hilft – Jelly hält bis zu 30 s vor." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speed fluctuates a lot (at times only %@ Mbit/s). A larger buffer helps—Jelly buffers up to 30 s ahead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitesse varie fortement (par moments seulement %@ Mbit/s). Une mémoire tampon plus grande aide – Jelly précharge jusqu'à 30 s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La velocidad varía mucho (a ratos solo %@ Mbit/s). Un búfer mayor ayuda: Jelly almacena hasta 30 s por delante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La velocità varia molto (a tratti solo %@ Mbit/s). Un buffer più grande aiuta: Jelly precarica fino a 30 s."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De snelheid schommelt sterk (soms maar %@ Mbit/s). Een grotere buffer helpt – Jelly buffert tot 30 s vooruit."
          }
        }
      }
    },
    "Die Leitung trägt alle Titel im Original." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your connection can play every title in original quality."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta connexion permet de lire tous les titres en qualité d'origine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu conexión puede reproducir todos los títulos en calidad original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua connessione può riprodurre tutti i titoli in qualità originale."
          }
