    "Zu Hause spricht Jelly den Server direkt im Heimnetz an (%@) – schneller als über das Internet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At home, Jelly talks to the server directly on your home network (%@)—faster than going over the internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la maison, Jelly communique directement avec le serveur sur ton réseau local (%@) – plus rapide qu'en passant par Internet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En casa, Jelly se comunica con el servidor directamente a través de tu red doméstica (%@), más rápido que por internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A casa, Jelly comunica con il server direttamente nella tua rete domestica (%@), più veloce che passare da internet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuis spreekt Jelly de server direct aan in je thuisnetwerk (%@) – sneller dan via het internet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em casa, o Jelly fala diretamente com o servidor na sua rede doméstica (%@) – mais rápido do que pela internet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derhjemme taler Jelly direkte med serveren på dit hjemmenetværk (%@) – hurtigere end via internettet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemma pratar Jelly direkt med servern i ditt hemnätverk (%@) – snabbare än via internet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W domu Jelly łączy się z serwerem bezpośrednio przez twoją sieć domową (%@) – szybciej niż przez internet."
          }
        }
      }
    },
