    "Beim Umrechnen macht der Server aus HDR normales SDR. Für HDR in angepasster Qualität braucht der Server einen 10-Bit-fähigen HEVC-Encoder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When converting, the server turns HDR into regular SDR. For HDR at adjusted quality, the server needs a 10-bit-capable HEVC encoder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de la conversion, le serveur transforme le HDR en SDR standard. Pour le HDR en qualité adaptée, le serveur a besoin d'un encodeur HEVC compatible 10 bits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al convertir, el servidor transforma el HDR en SDR normal. Para HDR con calidad ajustada, el servidor necesita un codificador HEVC compatible con 10 bits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la conversione, il server trasforma l'HDR in normale SDR. Per l'HDR in qualità adattata, il server ha bisogno di un encoder HEVC a 10 bit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het omzetten maakt de server van HDR gewoon SDR. Voor HDR in aangepaste kwaliteit heeft de server een HEVC-encoder nodig die 10 bit ondersteunt."
          }
        }
      }
    },
