    "Beide Werte stammen aus den Metadaten deines Jellyfin-Servers und fehlen bei Titeln, für die der Server keine Bewertung hat." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begge værdier kommer fra metadata på din Jellyfin-server og mangler for titler, som serveren ikke har en bedømmelse af."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both values come from your Jellyfin server's metadata and are missing for titles the server has no rating for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos valores proceden de los metadatos de tu servidor Jellyfin y faltan en los títulos que el servidor no tiene valorados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux valeurs proviennent des métadonnées de ton serveur Jellyfin et manquent pour les titres que le serveur n'a pas notés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi i valori provengono dai metadati del tuo server Jellyfin e mancano per i titoli che il server non ha valutato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide waarden komen uit de metadata van je Jellyfin-server en ontbreken bij titels waarvoor de server geen beoordeling heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obie wartości pochodzą z metadanych twojego serwera Jellyfin i brakuje ich przy tytułach, dla których serwer nie ma oceny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dois valores vêm dos metadados do seu servidor Jellyfin e não aparecem em títulos sem avaliação no servidor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Båda värdena kommer från metadata på din Jellyfin-server och saknas för titlar som servern inte har något betyg för."
          }
        }
      }
    },
