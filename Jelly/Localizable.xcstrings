    "Alle in einer Gruppe sehen dieselbe Sekunde desselben Films – jeder auf seinem Gerät, mit seinem eigenen Konto auf diesem Server." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone in a group sees the same second of the same film – each on their own device, with their own account on this server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les membres d’un groupe voient la même seconde du même film – chacun sur son appareil, avec son propre compte sur ce serveur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los miembros de un grupo ven el mismo segundo de la misma película, cada uno en su dispositivo y con su propia cuenta en este servidor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti in un gruppo vedono lo stesso secondo dello stesso film – ognuno sul proprio dispositivo, con il proprio account su questo server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen in een groep ziet dezelfde seconde van dezelfde film – ieder op zijn eigen apparaat, met zijn eigen account op deze server."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos em um grupo veem o mesmo segundo do mesmo filme – cada um no seu dispositivo, com a própria conta neste servidor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle i en gruppe ser det samme sekund af den samme film – hver på sin egen enhed, med sin egen konto på denne server."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla i en grupp ser samma sekund av samma film – var och en på sin egen enhet, med sitt eget konto på den här servern."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszyscy w grupie widzą tę samą sekundę tego samego filmu – każdy na swoim urządzeniu, z własnym kontem na tym serwerze."
          }
        }
      }
    },
