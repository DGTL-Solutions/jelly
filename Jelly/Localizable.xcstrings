            "state" : "translated",
            "value" : "Opent en decodeert video, audio en ondertiteling. Gebouwd zonder GPL-onderdelen met FFmpegBuild 3.9.0; broncode, wijzigingen en buildscript: https://github.com/superuser404notfound/FFmpegBuild"
          }
        },
        "pl" : {
          "stringUnit" : {
