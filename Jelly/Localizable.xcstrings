    "Freigegeben – sobald der Titel geladen ist, steht er in deiner Bibliothek." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approved—as soon as the title has downloaded, it will be in your library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvé – dès que le titre sera téléchargé, il apparaîtra dans ta bibliothèque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprobado: en cuanto se descargue el título, estará en tu biblioteca."
