    "Dafür fehlt deinem Konto die Berechtigung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account doesn't have permission to do this."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte n'a pas l'autorisation de faire cela."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta no tiene permiso para hacer esto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account non ha l'autorizzazione per farlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account heeft hiervoor geen toestemming."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conta não tem permissão para fazer isso."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto har ikke tilladelse til dette."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto har inte behörighet att göra detta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto nie ma uprawnień do tej czynności."
          }
        }
      }
    },
    "Das Abo verlängert sich automatisch um ein Jahr für %@, wenn du es nicht spätestens 24 Stunden vor Ablauf kündigst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The subscription automatically renews for one year at %@ unless you cancel it at least 24 hours before the end of the current period."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abonnement est renouvelé automatiquement pour un an au prix de %@, sauf si tu le résilies au moins 24 heures avant la fin de la période en cours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción se renueva automáticamente por un año a %@, salvo que la canceles al menos 24 horas antes de que termine el periodo actual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abbonamento si rinnova automaticamente per un anno a %@, a meno che tu non lo annulli almeno 24 ore prima della fine del periodo in corso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het abonnement wordt automatisch met een jaar verlengd voor %@, tenzij je het uiterlijk 24 uur voor het einde van de huidige periode opzegt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura é renovada automaticamente por um ano por %@, a menos que você a cancele pelo menos 24 horas antes do fim do período atual."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementet fornyes automatisk for et år ad gangen til %@, medmindre du opsiger det mindst 24 timer før udgangen af den aktuelle periode."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenumerationen förnyas automatiskt för ett år i taget till %@ om du inte avslutar den minst 24 timmar innan den aktuella perioden tar slut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcja odnawia się automatycznie na kolejny rok w cenie %@, chyba że anulujesz ją co najmniej 24 godziny przed końcem bieżącego okresu."
          }
        }
      }
    },
    "Das Abo wartet noch auf eine Bestätigung, zum Beispiel aus der Familienfreigabe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The subscription is still waiting for approval, for example through Family Sharing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abonnement attend encore une approbation, par exemple via le Partage familial."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción aún está pendiente de aprobación, por ejemplo, a través de En familia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abbonamento è ancora in attesa di approvazione, ad esempio tramite In famiglia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het abonnement wacht nog op goedkeuring, bijvoorbeeld via Delen met gezin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura ainda aguarda aprovação, por exemplo, pelo Compartilhamento Familiar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementet venter stadig på godkendelse, f.eks. via Familiedeling."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenumerationen väntar fortfarande på godkännande, till exempel via Familjedelning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcja wciąż czeka na zatwierdzenie, np. w ramach Chmury rodzinnej."
          }
        }
      }
    },
    "Das Apple TV hängt im WLAN. Ein LAN-Kabel macht große Dateien stabiler – besonders 4K." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple TV is on Wi-Fi. An Ethernet cable makes large files play more reliably—especially 4K."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Apple TV est connectée en Wi-Fi. Un câble Ethernet rend la lecture des gros fichiers plus stable – surtout en 4K."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Apple TV está conectado por Wi-Fi. Con un cable Ethernet, los archivos grandes se reproducen de forma más fiable, sobre todo en 4K."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua Apple TV è connessa via Wi-Fi. Un cavo Ethernet rende più affidabile la riproduzione dei file grandi, soprattutto in 4K."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Apple TV gebruikt wifi. Met een ethernetkabel worden grote bestanden betrouwbaarder afgespeeld – vooral 4K."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu Apple TV está no Wi-Fi. Um cabo Ethernet deixa a reprodução de arquivos grandes mais confiável – principalmente em 4K."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit Apple TV er på Wi-Fi. Et Ethernet-kabel får store filer til at spille mere stabilt – især 4K."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Apple TV är ansluten via Wi-Fi. Med en Ethernet-kabel spelas stora filer upp stabilare – särskilt 4K."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje Apple TV korzysta z Wi-Fi. Z kablem Ethernet duże pliki odtwarzają się stabilniej – zwłaszcza w 4K."
          }
        }
      }
    },
    "Das Apple TV schaltet für jeden Film automatisch auf Dolby Vision, HDR10 oder SDR und die passende Bildfrequenz um." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV automatically switches to Dolby Vision, HDR10, or SDR and the matching frame rate for each movie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Apple TV passe automatiquement en Dolby Vision, HDR10 ou SDR et à la fréquence d'images adaptée pour chaque film."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Apple TV cambia automáticamente a Dolby Vision, HDR10 o SDR y a la frecuencia de fotogramas adecuada para cada película."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV passa automaticamente a Dolby Vision, HDR10 o SDR e alla frequenza fotogrammi adatta a ogni film."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Apple TV schakelt voor elke film automatisch over op Dolby Vision, HDR10 of SDR en de juiste framesnelheid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple TV muda automaticamente para Dolby Vision, HDR10 ou SDR e para a taxa de quadros certa de cada filme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV skifter automatisk til Dolby Vision, HDR10 eller SDR og den passende billedfrekvens for hver film."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV växlar automatiskt till Dolby Vision, HDR10 eller SDR och rätt bildfrekvens för varje film."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV automatycznie przełącza się na Dolby Vision, HDR10 lub SDR i odpowiednią liczbę klatek na sekundę dla każdego filmu."
          }
        }
      }
    },
    "Das könnte dir auch gefallen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You Might Also Like"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pourrais aussi aimer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También te puede gustar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe piacerti anche"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misschien vind je dit ook leuk"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também pode gostar"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan du måske også lide"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kanske också gillar"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może ci się spodobać"
          }
        }
      }
    },
    "Das Overlay zeigt während der Wiedergabe, was die Leitung liefert, was der Film braucht, Puffer, Hänger und verlorene Bilder – und in Klartext, woran ein Stocken liegt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During playback, the overlay shows what your connection delivers, what the movie needs, buffer, stalls, and dropped frames—and explains in plain language what's causing any stuttering."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la lecture, la superposition affiche ce que fournit ta connexion, ce dont le film a besoin, la mémoire tampon, les interruptions et les images perdues – et explique clairement la cause des saccades."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la reproducción, la superposición muestra lo que ofrece tu conexión, lo que necesita la película, el búfer, las interrupciones y los fotogramas perdidos, y explica de forma sencilla qué provoca los tirones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la riproduzione, la sovrimpressione mostra cosa offre la tua connessione, di cosa ha bisogno il film, buffer, interruzioni e fotogrammi persi, e spiega in parole semplici cosa causa gli scatti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De overlay toont tijdens het afspelen wat je verbinding levert, wat de film nodig heeft, de buffer, haperingen en verloren frames – en legt in gewone taal uit waardoor het hapert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a reprodução, a sobreposição mostra o que a sua conexão entrega, o que o filme precisa, o buffer, as interrupções e os quadros descartados – e explica de forma simples o que está causando os travamentos."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under afspilning viser overlayet, hvad din forbindelse leverer, hvad filmen kræver, buffer, stop og tabte billeder – og forklarer i et klart sprog, hvad der får afspilningen til at hakke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under uppspelning visar överlägget vad din anslutning levererar, vad filmen behöver, buffert, avbrott och tappade bildrutor – och förklarar med enkla ord vad som orsakar eventuellt hackande."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas odtwarzania nakładka pokazuje, co dostarcza twoje połączenie, czego potrzebuje film, stan bufora, przestoje i utracone klatki – i prostymi słowami wyjaśnia, co powoduje ewentualne zacinanie się."
          }
        }
      }
    },
