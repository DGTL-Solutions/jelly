    "Tippe bei einem Film oder einer Folge auf %@, um sie für unterwegs zu speichern – ohne Verbindung zum Server abspielbar." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på %@ på en film eller et afsnit for at gemme det til farten – det kan afspilles uden forbindelse til din server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap %@ on a film or episode to save it for the road – it plays without a connection to your server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca %@ en una película o un episodio para guardarlo y llevártelo: se reproduce sin conexión con tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche %@ sur un film ou un épisode pour l'emporter partout – il se lit sans connexion à ton serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca %@ su un film o un episodio per portarlo con te: si riproduce senza connessione al tuo server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik bij een film of aflevering op %@ om hem te bewaren voor onderweg – hij speelt af zonder verbinding met je server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij %@ przy filmie lub odcinku, aby zabrać go w drogę – odtworzysz go bez połączenia z serwerem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em %@ em um filme ou episódio para salvá-lo e levar com você – ele é reproduzido sem conexão com o seu servidor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på %@ vid en film eller ett avsnitt för att ta med det på resan – det spelas upp utan anslutning till din server."
          }
        }
      }
    },
