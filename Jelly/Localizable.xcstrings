    "Der Server hat den Download abgelehnt (Fehler %lld)." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren afviste downloaden (fejl %lld)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused the download (error %lld)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha rechazado la descarga (error %lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé le téléchargement (erreur %lld)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha rifiutato il download (errore %lld)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server heeft de download geweigerd (fout %lld)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer odmówił pobrania (błąd %lld)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou o download (erro %lld)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern nekade hämtningen (fel %lld)."
          }
        }
      }
    },
    "Der Server hat die Anmeldung abgelehnt. Meist ist das Geräte-Limit deines Kontos erreicht – melde ein anderes Gerät ab oder bitte den Admin, das Limit zu erhöhen." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren afviste login. Som regel har din konto nået sin grænse for enheder – log ud på en anden enhed, eller bed administratoren om at hæve grænsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server rejected the sign-in. Usually your account has reached its device limit—sign out another device or ask the admin to raise the limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha rechazado el inicio de sesión. Normalmente, tu cuenta ha alcanzado su límite de dispositivos: cierra la sesión en otro dispositivo o pide al administrador que aumente el límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la connexion. Le plus souvent, ton compte a atteint sa limite d'appareils – déconnecte un autre appareil ou demande à l'administrateur d'augmenter la limite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha rifiutato l'accesso. Di solito il tuo account ha raggiunto il limite di dispositivi: esci da un altro dispositivo o chiedi all'amministratore di aumentare il limite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server heeft het inloggen geweigerd. Meestal is de apparaatlimiet van je account bereikt – log uit op een ander apparaat of vraag de beheerder de limiet te verhogen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer odrzucił logowanie. Zwykle oznacza to, że twoje konto osiągnęło limit urządzeń – wyloguj się na innym urządzeniu lub poproś administratora o zwiększenie limitu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou o início de sessão. Normalmente, a sua conta atingiu o limite de dispositivos – encerre a sessão em outro dispositivo ou peça ao administrador para aumentar o limite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern avvisade inloggningen. Oftast har ditt konto nått sin enhetsgräns – logga ut en annan enhet eller be administratören höja gränsen."
          }
        }
      }
    },
    "Der Server hat mit Fehler %lld geantwortet." : {
      "comment" : "HTTP status code",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren svarede med fejl %lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server responded with error %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha respondido con el error %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a répondu avec l'erreur %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha risposto con l'errore %lld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server antwoordde met fout %lld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer odpowiedział błędem %lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor respondeu com o erro %lld."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern svarade med fel %lld."
          }
        }
      }
    },
    "Der Server läuft über Cloudflare. Cloudflare erlaubt im kostenlosen Tarif kein großes Video-Streaming und kann drosseln – eine direkte Verbindung (z. B. per VPN wie Tailscale oder WireGuard) ist meist schneller." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren kører via Cloudflare. Cloudflares gratis abonnement tillader ikke videostreaming i stor skala og kan drosle den – en direkte forbindelse (f.eks. via en VPN som Tailscale eller WireGuard) er som regel hurtigere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server runs through Cloudflare. Cloudflare's free plan doesn't allow large-scale video streaming and may throttle it—a direct connection (e.g. via a VPN like Tailscale or WireGuard) is usually faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor funciona a través de Cloudflare. El plan gratuito de Cloudflare no permite streaming de vídeo a gran escala y puede limitarlo; una conexión directa (p. ej., mediante una VPN como Tailscale o WireGuard) suele ser más rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur passe par Cloudflare. L'offre gratuite de Cloudflare n'autorise pas le streaming vidéo à grande échelle et peut le brider – une connexion directe (p. ex. via un VPN comme Tailscale ou WireGuard) est généralement plus rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server passa attraverso Cloudflare. Il piano gratuito di Cloudflare non consente lo streaming video su larga scala e può rallentarlo: una connessione diretta (ad es. tramite una VPN come Tailscale o WireGuard) di solito è più veloce."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server loopt via Cloudflare. Het gratis abonnement van Cloudflare staat geen grootschalige videostreaming toe en kan de snelheid beperken – een directe verbinding (bijv. via een VPN zoals Tailscale of WireGuard) is meestal sneller."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer działa przez Cloudflare. Darmowy plan Cloudflare nie pozwala na strumieniowanie wideo na dużą skalę i może je spowalniać – bezpośrednie połączenie (np. przez VPN, taki jak Tailscale lub WireGuard) jest zwykle szybsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor passa pelo Cloudflare. O plano gratuito do Cloudflare não permite streaming de vídeo em grande escala e pode limitá-lo – uma conexão direta (p. ex., por uma VPN como Tailscale ou WireGuard) costuma ser mais rápida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern körs via Cloudflare. Cloudflares gratisplan tillåter inte videoströmning i stor skala och kan strypa den – en direktanslutning (t.ex. via ett VPN som Tailscale eller WireGuard) är oftast snabbare."
          }
        }
      }
    },
    "Der Server rechnet %@-mal schneller als Echtzeit um – angepasste Qualität läuft flüssig." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren konverterer %@× hurtigere end realtid – tilpasset kvalitet afspilles jævnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server converts %@× faster than real time—adjusted quality plays smoothly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor convierte %@× más rápido que en tiempo real; la calidad ajustada se reproduce con fluidez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur convertit %@× plus vite que le temps réel – la qualité adaptée est lue de façon fluide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server converte %@× più veloce del tempo reale: la qualità adattata viene riprodotta in modo fluido."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server zet %@× sneller dan realtime om – aangepaste kwaliteit wordt vloeiend afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer konwertuje %@× szybciej niż w czasie rzeczywistym – dostosowana jakość odtwarza się płynnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor converte %@× mais rápido que o tempo real – a qualidade ajustada é reproduzida sem travar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern konverterar %@× snabbare än realtid – anpassad kvalitet spelas upp smidigt."
          }
        }
      }
    },
    "Der Server rechnet das Bild herunter" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren sænker videokvaliteten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server lowers the video quality"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor reduce la calidad del vídeo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur réduit la qualité de l'image"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server riduce la qualità video"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server verlaagt de beeldkwaliteit"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer obniża jakość wideo"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor reduz a qualidade do vídeo"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern sänker videokvaliteten"
          }
        }
      }
    },
    "Der Server rechnet nur %@-mal so schnell wie Echtzeit um – angepasste Qualität kann stocken. Hardware-Beschleunigung im Jellyfin-Dashboard hilft." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren konverterer kun %@× så hurtigt som realtid – tilpasset kvalitet kan hakke. Det hjælper at slå hardwareacceleration til i Jellyfin-kontrolpanelet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server converts only %@× as fast as real time—adjusted quality may stutter. Turning on hardware acceleration in the Jellyfin dashboard helps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor convierte solo a %@× del tiempo real; la calidad ajustada puede ir a tirones. Activar la aceleración por hardware en el panel de control de Jellyfin ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ne convertit qu'à %@× le temps réel – la qualité adaptée peut saccader. Activer l'accélération matérielle dans le tableau de bord Jellyfin aide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server converte solo a %@× il tempo reale: la qualità adattata potrebbe andare a scatti. Attivare l'accelerazione hardware nella dashboard di Jellyfin aiuta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server zet maar %@× zo snel als realtime om – aangepaste kwaliteit kan haperen. Hardwareversnelling inschakelen in het Jellyfin-dashboard helpt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer konwertuje tylko z prędkością %@× czasu rzeczywistego – dostosowana jakość może się zacinać. Pomaga włączenie akceleracji sprzętowej w panelu Jellyfin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor converte só a %@× o tempo real – a qualidade ajustada pode travar. Ativar a aceleração por hardware no painel do Jellyfin ajuda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern konverterar bara %@× så snabbt som realtid – anpassad kvalitet kan hacka. Det hjälper att slå på hårdvaruacceleration i Jellyfin-kontrollpanelen."
          }
        }
      }
    },
    "Der Server steht nicht in diesem Netzwerk" : {
      "localizations" : {
