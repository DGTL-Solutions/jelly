    "Verbinde einen weiteren Jellyfin-Server. Deine bisherigen Anmeldungen bleiben erhalten; gewechselt wird in den Einstellungen." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbind en anden Jellyfin-server. Dine eksisterende logins bevares; du kan skifte i Indstillinger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect another Jellyfin server. Your existing sign-ins are kept; you can switch in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta otro servidor Jellyfin. Tus sesiones actuales se mantienen; puedes cambiar en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte un autre serveur Jellyfin. Tes connexions existantes sont conservées ; tu peux changer de serveur dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega un altro server Jellyfin. I tuoi accessi esistenti vengono mantenuti; puoi cambiare server in Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind nog een Jellyfin-server. Je bestaande inlogs blijven bewaard; wisselen doe je in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz kolejny serwer Jellyfin. Twoje dotychczasowe logowania zostaną zachowane; możesz przełączać się w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte outro servidor Jellyfin. As sessões existentes são mantidas; você pode alternar em Ajustes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut en till Jellyfin-server. Dina befintliga inloggningar finns kvar; du kan växla i Inställningar."
          }
        }
      }
    },
