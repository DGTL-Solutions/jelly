            "value" : "Nie udało się otworzyć pliku."
          }
        }
      }
    },
    "Die Datenschutzerklärung zum Lesen auf dem Handy: Code scannen oder die Adresse öffnen:\n\n%@\n\nDas Wichtigste steht auch hier darunter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To read the privacy policy on your phone, scan the code or open this address:\n\n%@\n\nThe key points are also summarized below."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lire la politique de confidentialité sur ton téléphone, scanne le code ou ouvre cette adresse :\n\n%@\n\nL'essentiel est aussi résumé ci-dessous."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para leer la política de privacidad en tu teléfono, escanea el código o abre esta dirección:\n\n%@\n\nAbajo también se resumen los puntos clave."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per leggere l'informativa sulla privacy sul telefono, scansiona il codice o apri questo indirizzo:\n\n%@\n\nI punti principali sono riassunti anche qui sotto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om het privacybeleid op je telefoon te lezen, scan je de code of open je dit adres:\n\n%@\n\nDe belangrijkste punten staan hieronder ook samengevat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ler a política de privacidade no celular, escaneie o código ou abra este endereço:\n\n%@\n\nOs pontos principais também estão resumidos abaixo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at læse anonymitetspolitikken på din telefon skal du scanne koden eller åbne denne adresse:\n\n%@\n\nDe vigtigste punkter er også opsummeret nedenfor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du vill läsa integritetspolicyn på telefonen skannar du koden eller öppnar den här adressen:\n\n%@\n\nDe viktigaste punkterna sammanfattas också nedan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby przeczytać politykę prywatności na telefonie, zeskanuj kod lub otwórz ten adres:\n\n%@\n\nNajważniejsze punkty znajdziesz też poniżej."
          }
        }
      }
    },
    "Die Geschwindigkeit schwankt stark (zeitweise nur %@ Mbit/s). Ein größerer Puffer hilft – Jelly hält bis zu 30 s vor." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speed fluctuates a lot (at times only %@ Mbit/s). A larger buffer helps—Jelly buffers up to 30 s ahead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitesse varie fortement (par moments seulement %@ Mbit/s). Une mémoire tampon plus grande aide – Jelly précharge jusqu'à 30 s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La velocidad varía mucho (a ratos solo %@ Mbit/s). Un búfer mayor ayuda: Jelly almacena hasta 30 s por delante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La velocità varia molto (a tratti solo %@ Mbit/s). Un buffer più grande aiuta: Jelly precarica fino a 30 s."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De snelheid schommelt sterk (soms maar %@ Mbit/s). Een grotere buffer helpt – Jelly buffert tot 30 s vooruit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A velocidade varia muito (às vezes só %@ Mbit/s). Um buffer maior ajuda – o Jelly armazena até 30 s à frente."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastigheden svinger meget (til tider kun %@ Mbit/s). En større buffer hjælper – Jelly bufferer op til 30 s forud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hastigheten varierar mycket (ibland bara %@ Mbit/s). En större buffert hjälper – Jelly buffrar upp till 30 s i förväg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prędkość mocno się waha (chwilami tylko %@ Mbit/s). Pomaga większy bufor – Jelly buforuje do 30 s do przodu."
          }
        }
      }
    },
    "Die Leitung trägt alle Titel im Original." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your connection can play every title in original quality."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta connexion permet de lire tous les titres en qualité d'origine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu conexión puede reproducir todos los títulos en calidad original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua connessione può riprodurre tutti i titoli in qualità originale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je verbinding kan elke titel in originele kwaliteit afspelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conexão consegue reproduzir todos os títulos em qualidade original."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din forbindelse kan afspille alle titler i original kvalitet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din anslutning kan spela upp alla titlar i originalkvalitet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje połączenie pozwala odtworzyć każdy tytuł w oryginalnej jakości."
          }
        }
      }
    },
    "Die Leitung trägt auch die größten Dateien deiner Bibliothek." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your connection can handle even the largest files in your library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta connexion supporte même les plus gros fichiers de ta bibliothèque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu conexión puede con los archivos más grandes de tu biblioteca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua connessione regge anche i file più grandi della tua libreria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je verbinding kan zelfs de grootste bestanden in je bibliotheek aan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conexão dá conta até dos maiores arquivos da sua biblioteca."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din forbindelse kan klare selv de største filer i dit bibliotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din anslutning klarar till och med de största filerna i ditt bibliotek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje połączenie poradzi sobie nawet z największymi plikami w twojej bibliotece."
          }
        }
      }
    },
    "Die meisten Titel muss der Server herunterrechnen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server has to convert most titles to a lower quality."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur doit réduire la qualité de la plupart des titres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor tiene que convertir la mayoría de los títulos a una calidad inferior."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server deve convertire la maggior parte dei titoli in una qualità inferiore."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server moet de meeste titels omzetten naar een lagere kwaliteit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor precisa converter a maioria dos títulos para uma qualidade menor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren skal konvertere de fleste titler til en lavere kvalitet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern måste konvertera de flesta titlar till lägre kvalitet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer musi konwertować większość tytułów do niższej jakości."
          }
        }
      }
    },
    "Die Ton-Synchronisation übernimmt bei diesem Titel Apples Player selbst." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For this title, Apple's player handles audio sync itself."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ce titre, le lecteur d'Apple gère lui-même la synchronisation audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este título, el reproductor de Apple gestiona por sí mismo la sincronización del audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per questo titolo, il player di Apple gestisce da solo la sincronizzazione audio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij deze titel regelt de speler van Apple de audiosynchronisatie zelf."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste título, o player da Apple cuida sozinho da sincronia do áudio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For denne titel styrer Apples afspiller selv lydsynkroniseringen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För den här titeln sköter Apples spelare ljudsynkroniseringen själv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku tego tytułu synchronizacją dźwięku zajmuje się odtwarzacz Apple."
          }
        }
      }
    },
    "Die Verbindung zum Server ist abgebrochen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection to the server was lost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion au serveur a été interrompue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha perdido la conexión con el servidor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione al server si è interrotta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met de server is verbroken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com o servidor foi perdida."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen til serveren blev afbrudt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen till servern bröts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utracono połączenie z serwerem."
          }
        }
      }
    },
    "Die Wiedergabe stockt – Details unter ↓ › Info" : {
      "comment" : "↓ › Info: swipe down, then the Info tab of the player panel",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback is stuttering—details under ↓ › Info"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture saccade – détails sous ↓ › Infos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reproducción va a tirones; detalles en ↓ › Información"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riproduzione va a scatti: dettagli in ↓ › Info"
          }
        },
        "nl" : {
