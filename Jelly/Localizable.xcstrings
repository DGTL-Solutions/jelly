          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Jellyfin on your phone or computer, tap your profile › Quick Connect, and enter this code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Jellyfin en tu teléfono u ordenador, toca tu perfil › Quick Connect e introduce este código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Jellyfin sur ton téléphone ou ton ordinateur, touche ton profil › Quick Connect, puis saisis ce code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Jellyfin sul telefono o sul computer, tocca il tuo profilo › Quick Connect e inserisci questo codice."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Jellyfin op je telefoon of computer, tik op je profiel › Quick Connect en voer deze code in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Jellyfin na telefonie lub komputerze, stuknij swój profil › Quick Connect i wprowadź ten kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
