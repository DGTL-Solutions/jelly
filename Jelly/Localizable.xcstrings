        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um servidor para alternar para ele – Biblioteca, Continuar assistindo e Top Shelf acompanham o servidor ativo. As suas sessões continuam salvas."
          }
        },
        "sv" : {
          "stringUnit" : {
