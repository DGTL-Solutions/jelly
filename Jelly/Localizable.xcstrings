    "Jelly darf nicht auf dein Zuhause zugreifen. Erlaube es in den Apple-TV-Einstellungen unter Datenschutz › HomeKit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelly isn’t allowed to access your home. Allow it in the Apple TV settings under Privacy › HomeKit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelly n’est pas autorisé à accéder à ton domicile. Autorise-le dans les réglages de l’Apple TV sous Confidentialité › HomeKit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
