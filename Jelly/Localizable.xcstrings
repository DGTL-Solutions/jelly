    "Begrenzt dieses Profil auf eine Altersfreigabe. Einstellungen, andere Profile und Erkunden sind dann nur mit einem PIN der Eltern zugänglich." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limits this profile to an age rating. Settings, other profiles and Discover then open only with a parents’ PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite ce profil à une classification d’âge. Les réglages, les autres profils et Découvrir ne s’ouvrent alors qu’avec un code PIN des parents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita este perfil a una clasificación por edades. Los ajustes, los demás perfiles y Descubrir solo se abren con un PIN de los padres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita questo profilo a una classificazione per età. Impostazioni, altri profili ed Esplora si aprono solo con un PIN dei genitori."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beperkt dit profiel tot een leeftijdsclassificatie. Instellingen, andere profielen en Ontdek openen dan alleen met een pincode van de ouders."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita este perfil a uma classificação etária. Ajustes, outros perfis e Explorar só abrem com um PIN dos pais."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrænser denne profil til en aldersgrænse. Indstillinger, andre profiler og Udforsk åbner så kun med forældrenes pinkode."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begränsar den här profilen till en åldersgräns. Inställningar, andra profiler och Utforska öppnas då bara med föräldrarnas PIN-kod."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogranicza ten profil do kategorii wiekowej. Ustawienia, inne profile i Odkrywaj otwierają się wtedy tylko po podaniu kodu PIN rodziców."
          }
        }
      }
    },
