    "Freigegeben – sobald der Titel geladen ist, steht er in deiner Bibliothek." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkendt – så snart titlen er hentet, er den i dit bibliotek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approved—as soon as the title has downloaded, it will be in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprobado: en cuanto se descargue el título, estará en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuvé – dès que le titre sera téléchargé, il apparaîtra dans ta bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approvato: appena il titolo sarà scaricato, comparirà nella tua libreria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goedgekeurd – zodra de titel is gedownload, staat hij in je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatwierdzono – gdy tylko tytuł się pobierze, pojawi się w twojej bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprovado – assim que o download do título terminar, ele estará na sua biblioteca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänd – så snart titeln har laddats ned finns den i ditt bibliotek."
          }
        }
