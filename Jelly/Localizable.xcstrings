    "Dieses Profil zeigt nur Titel bis %@. Einstellungen, andere Profile und Erkunden öffnen nur mit dem PIN." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This profile shows only titles up to %@. Settings, other profiles and Discover open only with the PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil n’affiche que les titres jusqu’à %@. Les réglages, les autres profils et Découvrir ne s’ouvrent qu’avec le code PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil solo muestra títulos hasta %@. Los ajustes, los demás perfiles y Descubrir solo se abren con el PIN."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo profilo mostra solo titoli fino a %@. Impostazioni, altri profili ed Esplora si aprono solo con il PIN."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit profiel toont alleen titels tot en met %@. Instellingen, andere profielen en Ontdek openen alleen met de pincode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil mostra apenas títulos até %@. Ajustes, outros perfis e Explorar só abrem com o PIN."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne profil viser kun titler op til %@. Indstillinger, andre profiler og Udforsk åbner kun med pinkoden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här profilen visar bara titlar upp till %@. Inställningar, andra profiler och Utforska öppnas bara med PIN-koden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten profil pokazuje tylko tytuły do %@. Ustawienia, inne profile i Odkrywaj otwierają się tylko po podaniu kodu PIN."
          }
        }
      }
    },
    "Dimmt das Licht, wenn der Film läuft, und macht es bei Pause wieder heller. Die Szenen legst du in Apples Home-App an." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dims the lights while the film runs and brightens them again on pause. You create the scenes in Apple’s Home app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamise la lumière pendant le film et la rallume en pause. Tu crées les scènes dans l’app Maison d’Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenúa la luz mientras se reproduce la película y la sube de nuevo en pausa. Las escenas se crean en la app Casa de Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa le luci mentre il film è in riproduzione e le rialza in pausa. Le scene si creano nell’app Casa di Apple."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimt het licht terwijl de film speelt en maakt het bij pauze weer lichter. De scènes maak je in de Woning-app van Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminui a luz enquanto o filme passa e a aumenta de novo na pausa. As cenas são criadas no app Casa da Apple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dæmper lyset, mens filmen kører, og skruer op igen ved pause. Scenerne opretter du i Apples Hjem-app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dämpar ljuset medan filmen spelas och gör det ljusare igen vid paus. Scenerna skapar du i Apples app Hem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciemnia światło podczas filmu i rozjaśnia je przy pauzie. Sceny tworzysz w aplikacji Dom firmy Apple."
          }
        }
      }
    },
