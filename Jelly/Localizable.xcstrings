    "%@ deiner Titel laufen im Original." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ of your titles play in original quality."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de tes titres sont lus en qualité d'origine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El %@ de tus títulos se reproduce en calidad original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dei tuoi titoli vengono riprodotti in qualità originale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ van je titels worden in originele kwaliteit afgespeeld."
          }
        }
      }
    },
    "%@ deiner Titel laufen im Original. Sehr große 4K-Remuxe passt Jelly automatisch an." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ of your titles play in original quality. Jelly automatically adjusts very large 4K remuxes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de tes titres sont lus en qualité d'origine. Jelly adapte automatiquement les remux 4K très volumineux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El %@ de tus títulos se reproduce en calidad original. Jelly ajusta automáticamente los remux 4K muy grandes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dei tuoi titoli vengono riprodotti in qualità originale. Jelly adatta automaticamente i remux 4K molto grandi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ van je titels worden in originele kwaliteit afgespeeld. Zeer grote 4K-remuxes past Jelly automatisch aan."
          }
        }
      }
    },
