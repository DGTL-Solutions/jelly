    "Die sichere Verbindung (HTTPS) zu %@ ist fehlgeschlagen – das Zertifikat wurde nicht akzeptiert." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den sikre forbindelse (HTTPS) til %@ mislykkedes – certifikatet blev ikke accepteret."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The secure connection (HTTPS) to %@ failed – the certificate wasn't accepted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión segura (HTTPS) con %@ ha fallado: no se ha aceptado el certificado."
