    "Diese App. Ihr Quellcode ist offen – damit lässt sie sich auch mit geänderten Bibliotheken neu bauen, wie die LGPL es verlangt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app. Its source code is open, so it can be rebuilt with modified libraries, as the LGPL requires."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app. Son code source est ouvert, ce qui permet de la recompiler avec des bibliothèques modifiées, comme l'exige la LGPL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app. Su código fuente es abierto, por lo que puede recompilarse con bibliotecas modificadas, tal como exige la LGPL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app. Il suo codice sorgente è aperto, quindi può essere ricompilata con librerie modificate, come richiesto dalla LGPL."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app. De broncode is openbaar, zodat de app ook met gewijzigde bibliotheken opnieuw kan worden gebouwd, zoals de LGPL vereist."
          }
        }
      }
