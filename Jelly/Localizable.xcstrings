    "Gewünscht – ein Admin muss den Wunsch noch freigeben. Danach erscheint er automatisch in deiner Bibliothek." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requested—an admin still has to approve your request. Then the title will appear in your library automatically."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandé – un administrateur doit encore approuver ta demande. Le titre apparaîtra ensuite automatiquement dans ta bibliothèque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado: un administrador aún tiene que aprobar tu solicitud. Después, el título aparecerá automáticamente en tu biblioteca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesto: un amministratore deve ancora approvare la tua richiesta. Poi il titolo comparirà automaticamente nella tua libreria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangevraagd – een beheerder moet je aanvraag nog goedkeuren. Daarna verschijnt de titel automatisch in je bibliotheek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado – um administrador ainda precisa aprovar a sua solicitação. Depois, o título aparecerá automaticamente na sua biblioteca."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmodet – en administrator skal stadig godkende din anmodning. Derefter vises titlen automatisk i dit bibliotek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begärd – en administratör måste fortfarande godkänna din förfrågan. Sedan dyker titeln upp i ditt bibliotek automatiskt."
          }
        },
        "pl" : {
