          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre et décode la vidéo, l'audio et les sous-titres. Compilé sans composants GPL avec FFmpegBuild 3.9.0 ; code source, modifications et script de compilation : https://github.com/superuser404notfound/FFmpegBuild"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre e decodifica video, audio e sottotitoli. Compilato senza componenti GPL con FFmpegBuild 3.9.0; codice sorgente, modifiche e script di build: https://github.com/superuser404notfound/FFmpegBuild"
          }
        },
        "nl" : {
