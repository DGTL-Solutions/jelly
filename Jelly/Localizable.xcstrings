    "Jahresabo abschließen – %@ pro Jahr" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscribe for %@ per Year"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'abonner pour %@ par an"
          }
        },
        "es" : {
          "stringUnit" : {
