            "value" : "La tua connessione regge anche i file più grandi della tua libreria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je verbinding kan zelfs de grootste bestanden in je bibliotheek aan."
          }
        }
      }
    },
    "Die meisten Titel muss der Server herunterrechnen." : {
      "localizations" : {
