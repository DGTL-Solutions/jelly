    "Die Anmeldung bei Jellyseerr ist abgelaufen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Jellyseerr sign-in has expired."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta connexion à Jellyseerr a expiré."
          }
        }
      }
    },
    "Die Anmeldung konnte nicht sicher gespeichert werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in couldn't be stored securely."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta connexion n'a pas pu être enregistrée de façon sécurisée."
          }
        }
      }
    },
    "Die Datei konnte nicht geöffnet werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file couldn't be opened."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n'a pas pu être ouvert."
          }
        }
      }
    },
    "Die Datenschutzerklärung zum Lesen auf dem Handy: Code scannen oder die Adresse öffnen:\n\n%@\n\nDas Wichtigste steht auch hier darunter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To read the privacy policy on your phone, scan the code or open this address:\n\n%@\n\nThe key points are also summarized below."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lire la politique de confidentialité sur ton téléphone, scanne le code ou ouvre cette adresse :\n\n%@\n\nL'essentiel est aussi résumé ci-dessous."
          }
        }
      }
    },
    "Die Geschwindigkeit schwankt stark (zeitweise nur %@ Mbit/s). Ein größerer Puffer hilft – Jelly hält bis zu 30 s vor." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speed fluctuates a lot (at times only %@ Mbit/s). A larger buffer helps—Jelly buffers up to 30 s ahead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitesse varie fortement (par moments seulement %@ Mbit/s). Une mémoire tampon plus grande aide – Jelly précharge jusqu'à 30 s."
          }
        }
      }
    },
    "Die Leitung trägt alle Titel im Original." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your connection can play every title in original quality."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta connexion permet de lire tous les titres en qualité d'origine."
          }
        }
      }
    },
    "Die Leitung trägt auch die größten Dateien deiner Bibliothek." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your connection can handle even the largest files in your library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta connexion supporte même les plus gros fichiers de ta bibliothèque."
          }
        }
      }
    },
    "Die meisten Titel muss der Server herunterrechnen." : {
