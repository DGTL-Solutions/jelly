    "%@ deiner Titel laufen im Original." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ of your titles play in original quality."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de tes titres sont lus en qualité d'origine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El %@ de tus títulos se reproduce en calidad original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dei tuoi titoli vengono riprodotti in qualità originale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ van je titels worden in originele kwaliteit afgespeeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dos seus títulos são reproduzidos em qualidade original."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ af dine titler afspilles i original kvalitet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ av dina titlar spelas upp i originalkvalitet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ twoich tytułów odtwarza się w oryginalnej jakości."
          }
        }
      }
    },
    "%@ deiner Titel laufen im Original. Sehr große 4K-Remuxe passt Jelly automatisch an." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
