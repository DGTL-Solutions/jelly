    "Dein Jellyseerr-Konto darf das nicht." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Jellyseerr account isn't allowed to do that."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte Jellyseerr n'a pas l'autorisation de faire cela."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de Jellyseerr no tiene permiso para hacer eso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account Jellyseerr non è autorizzato a farlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Jellyseerr-account mag dat niet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conta do Jellyseerr não tem permissão para isso."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Jellyseerr-konto har ikke tilladelse til det."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt Jellyseerr-konto får inte göra det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto Jellyseerr nie ma do tego uprawnień."
          }
        }
      }
    },
    "Dein Konto darf nicht umrechnen lassen. Titel über der Leitungsgeschwindigkeit werden stocken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account isn't allowed to use server conversion. Titles above your connection speed will stutter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte n'est pas autorisé à utiliser la conversion par le serveur. Les titres qui dépassent la vitesse de ta connexion vont saccader."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta no tiene permiso para usar la conversión del servidor. Los títulos que superen la velocidad de tu conexión se reproducirán a tirones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account non è autorizzato a usare la conversione del server. I titoli che superano la velocità della tua connessione andranno a scatti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account mag de server niet laten omzetten. Titels boven je verbindingssnelheid zullen haperen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conta não tem permissão para usar a conversão do servidor. Títulos acima da velocidade da sua conexão vão travar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto har ikke tilladelse til at bruge konvertering på serveren. Titler over din forbindelseshastighed vil hakke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto får inte använda serverkonvertering. Titlar över din anslutningshastighet kommer att hacka."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto nie może korzystać z konwersji na serwerze. Tytuły przekraczające prędkość twojego połączenia będą się zacinać."
          }
        }
      }
    },
    "Dein Konto erlaubt %lld gleichzeitige Anmeldungen; Jelly auf diesem Apple TV ist eine davon." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your account allows %lld sign-in at a time; Jelly on this Apple TV is using it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your account allows %lld sign-ins at a time; Jelly on this Apple TV is one of them."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ton compte autorise %lld connexion simultanée ; Jelly sur cette Apple TV l'utilise."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ton compte autorise %lld connexions simultanées ; Jelly sur cette Apple TV en est une."
                }
              }
            }
          }
        },
        "es" : {
