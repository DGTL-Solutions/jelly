    "TrueHD und DTS gibt das Apple TV verlustfrei als Mehrkanal-PCM aus; Atmos-Objekte überträgt tvOS nur aus Dolby Digital Plus." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV outputs TrueHD and DTS losslessly as multichannel PCM; tvOS passes through Atmos objects only from Dolby Digital Plus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Apple TV restitue le TrueHD et le DTS sans perte en PCM multicanal ; tvOS ne transmet les objets Atmos qu'à partir du Dolby Digital Plus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Apple TV emite TrueHD y DTS sin pérdida como PCM multicanal; tvOS solo transmite los objetos Atmos desde Dolby Digital Plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV emette TrueHD e DTS senza perdita come PCM multicanale; tvOS trasmette gli oggetti Atmos solo da Dolby Digital Plus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Apple TV voert TrueHD en DTS verliesvrij uit als meerkanaals PCM; Atmos-objecten geeft tvOS alleen door vanuit Dolby Digital Plus."
          }
        }
      }
    },
