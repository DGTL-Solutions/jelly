    "Dein Jellyseerr-Konto darf das nicht." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Jellyseerr account isn't allowed to do that."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte Jellyseerr n'a pas l'autorisation de faire cela."
          }
        }
      }
    },
    "Dein Konto darf nicht umrechnen lassen. Titel über der Leitungsgeschwindigkeit werden stocken." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account isn't allowed to use server conversion. Titles above your connection speed will stutter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte n'est pas autorisé à utiliser la conversion par le serveur. Les titres qui dépassent la vitesse de ta connexion vont saccader."
          }
        }
      }
    },
    "Dein Konto erlaubt %lld gleichzeitige Anmeldungen; Jelly auf diesem Apple TV ist eine davon." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your account allows %lld sign-in at a time; Jelly on this Apple TV is using it."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your account allows %lld sign-ins at a time; Jelly on this Apple TV is one of them."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ton compte autorise %lld connexion simultanée ; Jelly sur cette Apple TV l'utilise."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ton compte autorise %lld connexions simultanées ; Jelly sur cette Apple TV en est une."
                }
              }
            }
          }
        }
      }
    },
    "Dein Konto erlaubt %lld gleichzeitige Anmeldungen; Jelly auf diesem Gerät ist eine davon." : {
      "localizations" : {
