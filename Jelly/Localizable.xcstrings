    },
    "%@ deiner Titel laufen im Original. Sehr große 4K-Remuxe passt Jelly automatisch an." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ af dine titler afspilles i original kvalitet. Jelly tilpasser automatisk meget store 4K-remuxes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ of your titles play in original quality. Jelly automatically adjusts very large 4K remuxes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El %@ de tus títulos se reproduce en calidad original. Jelly ajusta automáticamente los remux 4K muy grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de tes titres sont lus en qualité d'origine. Jelly adapte automatiquement les remux 4K très volumineux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dei tuoi titoli vengono riprodotti in qualità originale. Jelly adatta automaticamente i remux 4K molto grandi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ van je titels worden in originele kwaliteit afgespeeld. Zeer grote 4K-remuxes past Jelly automatisch aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ twoich tytułów odtwarza się w oryginalnej jakości. Bardzo duże remuksy 4K Jelly dostosowuje automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dos seus títulos são reproduzidos em qualidade original. O Jelly ajusta automaticamente remuxes 4K muito grandes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ av dina titlar spelas upp i originalkvalitet. Jelly anpassar mycket stora 4K-remuxar automatiskt."
          }
        }
      }
    },
