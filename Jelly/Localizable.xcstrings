    "Verbinde einen weiteren Jellyfin-Server. Deine bisherigen Anmeldungen bleiben erhalten; gewechselt wird in den Einstellungen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect another Jellyfin server. Your existing sign-ins are kept; you can switch in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
