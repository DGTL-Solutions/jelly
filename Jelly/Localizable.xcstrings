          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się bezpiecznie zapisać danych logowania."
          }
        }
      }
    },
    "Die Datei konnte nicht geöffnet werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
