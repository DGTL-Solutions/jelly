          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in på %@. Tips: Med tangentbordet på iPhone kan du fylla i sparade lösenord."
          }
        },
        "pl" : {
          "stringUnit" : {
