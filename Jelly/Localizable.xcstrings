    "Der App Store ist gerade nicht erreichbar. Bitte versuch es gleich noch einmal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The App Store can't be reached right now. Please try again in a moment."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'App Store est injoignable pour le moment. Réessaie dans un instant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder al App Store en este momento. Vuelve a intentarlo dentro de un momento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'App Store non è raggiungibile al momento. Riprova tra poco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De App Store is momenteel niet bereikbaar. Probeer het zo nog eens."
          }
        }
      }
    },
    "Der Code ist abgelaufen. Bitte erneut versuchen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code has expired. Please try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code a expiré. Réessaie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código ha caducado. Vuelve a intentarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice è scaduto. Riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De code is verlopen. Probeer het opnieuw."
          }
        }
      }
    },
    "Der Player konnte nicht gestartet werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player couldn't be started."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lecteur n'a pas pu être lancé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido iniciar el reproductor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile avviare il player."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De speler kan niet worden gestart."
          }
        }
      }
    },
    "Der Server begrenzt Fernzugriffe auf %lld Mbit/s." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server limits remote access to %lld Mbit/s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur limite l'accès à distance à %lld Mbit/s."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor limita el acceso remoto a %lld Mbit/s."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server limita l'accesso remoto a %lld Mbit/s."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server beperkt externe toegang tot %lld Mbit/s."
          }
        }
      }
    },
    "Der Server hat die Anmeldung abgelehnt. Meist ist das Geräte-Limit deines Kontos erreicht – melde ein anderes Gerät ab oder bitte den Admin, das Limit zu erhöhen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server rejected the sign-in. Usually your account has reached its device limit—sign out another device or ask the admin to raise the limit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la connexion. Le plus souvent, ton compte a atteint sa limite d'appareils – déconnecte un autre appareil ou demande à l'administrateur d'augmenter la limite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha rechazado el inicio de sesión. Normalmente, tu cuenta ha alcanzado su límite de dispositivos: cierra la sesión en otro dispositivo o pide al administrador que aumente el límite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha rifiutato l'accesso. Di solito il tuo account ha raggiunto il limite di dispositivi: esci da un altro dispositivo o chiedi all'amministratore di aumentare il limite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server heeft het inloggen geweigerd. Meestal is de apparaatlimiet van je account bereikt – log uit op een ander apparaat of vraag de beheerder de limiet te verhogen."
          }
        }
      }
    },
    "Der Server hat mit Fehler %lld geantwortet." : {
      "comment" : "HTTP status code",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server responded with error %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a répondu avec l'erreur %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha respondido con el error %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha risposto con l'errore %lld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server antwoordde met fout %lld."
          }
        }
      }
    },
    "Der Server läuft über Cloudflare. Cloudflare erlaubt im kostenlosen Tarif kein großes Video-Streaming und kann drosseln – eine direkte Verbindung (z. B. per VPN wie Tailscale oder WireGuard) ist meist schneller." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server runs through Cloudflare. Cloudflare's free plan doesn't allow large-scale video streaming and may throttle it—a direct connection (e.g. via a VPN like Tailscale or WireGuard) is usually faster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur passe par Cloudflare. L'offre gratuite de Cloudflare n'autorise pas le streaming vidéo à grande échelle et peut le brider – une connexion directe (p. ex. via un VPN comme Tailscale ou WireGuard) est généralement plus rapide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor funciona a través de Cloudflare. El plan gratuito de Cloudflare no permite streaming de vídeo a gran escala y puede limitarlo; una conexión directa (p. ej., mediante una VPN como Tailscale o WireGuard) suele ser más rápida."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server passa attraverso Cloudflare. Il piano gratuito di Cloudflare non consente lo streaming video su larga scala e può rallentarlo: una connessione diretta (ad es. tramite una VPN come Tailscale o WireGuard) di solito è più veloce."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server loopt via Cloudflare. Het gratis abonnement van Cloudflare staat geen grootschalige videostreaming toe en kan de snelheid beperken – een directe verbinding (bijv. via een VPN zoals Tailscale of WireGuard) is meestal sneller."
          }
        }
      }
    },
    "Der Server rechnet %@-mal schneller als Echtzeit um – angepasste Qualität läuft flüssig." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server converts %@× faster than real time—adjusted quality plays smoothly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur convertit %@× plus vite que le temps réel – la qualité adaptée est lue de façon fluide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor convierte %@× más rápido que en tiempo real; la calidad ajustada se reproduce con fluidez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server converte %@× più veloce del tempo reale: la qualità adattata viene riprodotta in modo fluido."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server zet %@× sneller dan realtime om – aangepaste kwaliteit wordt vloeiend afgespeeld."
          }
        }
      }
    },
    "Der Server rechnet das Bild herunter" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server lowers the video quality"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur réduit la qualité de l'image"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor reduce la calidad del vídeo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server riduce la qualità video"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server verlaagt de beeldkwaliteit"
          }
        }
      }
    },
    "Der Server rechnet nur %@-mal so schnell wie Echtzeit um – angepasste Qualität kann stocken. Hardware-Beschleunigung im Jellyfin-Dashboard hilft." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server converts only %@× as fast as real time—adjusted quality may stutter. Turning on hardware acceleration in the Jellyfin dashboard helps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ne convertit qu'à %@× le temps réel – la qualité adaptée peut saccader. Activer l'accélération matérielle dans le tableau de bord Jellyfin aide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor convierte solo a %@× del tiempo real; la calidad ajustada puede ir a tirones. Activar la aceleración por hardware en el panel de control de Jellyfin ayuda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server converte solo a %@× il tempo reale: la qualità adattata potrebbe andare a scatti. Attivare l'accelerazione hardware nella dashboard di Jellyfin aiuta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server zet maar %@× zo snel als realtime om – aangepaste kwaliteit kan haperen. Hardwareversnelling inschakelen in het Jellyfin-dashboard helpt."
          }
        }
      }
    },
    "Der Server steht nicht in diesem Netzwerk" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server isn't on this network"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n'est pas sur ce réseau"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no está en esta red"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non è su questa rete"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server staat niet in dit netwerk"
          }
        }
      }
    },
    "Der Server wird über das Internet erreicht. Die Grenze ist meist der Upload am Anschluss des Servers – mehr als dieser Upload kommt nirgends an." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server is reached over the internet. The limit is usually the upload speed of the server's internet connection—nothing arrives faster than that upload."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur est joint via Internet. La limite est généralement le débit montant de la connexion du serveur – rien n'arrive plus vite que ce débit montant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se accede al servidor a través de internet. El límite suele ser la velocidad de subida de la conexión a internet del servidor: nada llega más rápido que esa subida."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server viene raggiunto tramite internet. Il limite di solito è la velocità di upload della connessione internet del server: niente arriva più veloce di quell'upload."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server wordt via het internet bereikt. De grens is meestal de uploadsnelheid van de internetverbinding van de server – niets komt sneller binnen dan die upload."
          }
        }
      }
    },
    "Der Titel liegt auf dem Jellyfin-Server, mit dem Jellyseerr verbunden ist – in deiner aktuellen Bibliothek wurde er nicht gefunden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This title is on the Jellyfin server that Jellyseerr is connected to—it wasn't found in your current library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce titre se trouve sur le serveur Jellyfin auquel Jellyseerr est connecté – il est introuvable dans ta bibliothèque actuelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título está en el servidor Jellyfin al que está conectado Jellyseerr; no se ha encontrado en tu biblioteca actual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo titolo si trova sul server Jellyfin a cui è collegato Jellyseerr: non è stato trovato nella tua libreria attuale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze titel staat op de Jellyfin-server waarmee Jellyseerr is verbonden – hij is niet gevonden in je huidige bibliotheek."
          }
        }
      }
    },
