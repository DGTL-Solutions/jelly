    "Bis zum Ende des Probezeitraums ist alles kostenlos. Danach kostet das Jelly Jahresabo %@ pro Jahr." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt er gratis, indtil din gratis prøveperiode slutter. Derefter koster Jelly-årsabonnementet %@ om året."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is free until your free trial ends. After that, the Jelly Annual Subscription costs %@ per year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo es gratis hasta que termine tu prueba gratuita. Después, la suscripción anual de Jelly cuesta %@ al año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est gratuit jusqu'à la fin de la période d'essai. Ensuite, l'abonnement annuel Jelly coûte %@ par an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto è gratuito fino alla fine del periodo di prova. Dopo, l'abbonamento annuale a Jelly costa %@ all'anno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot het einde van je proefperiode is alles gratis. Daarna kost het Jelly-jaarabonnement %@ per jaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do końca bezpłatnego okresu próbnego wszystko jest za darmo. Potem roczna subskrypcja Jelly kosztuje %@ rocznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo é grátis até o fim do seu período de teste. Depois disso, a Assinatura Anual do Jelly custa %@ por ano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt är gratis tills din kostnadsfria provperiod tar slut. Därefter kostar Jelly årsprenumeration %@ per år."
          }
        }
      }
    },
