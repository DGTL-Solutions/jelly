    },
    "„Besser“ und „Gut“ rechnet dein Server beim Laden um. Die Größe ist eine Obergrenze, meist wird die Datei kleiner." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your server converts “Better” and “Good” while they download. The size is an upper limit; the file usually ends up smaller."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton serveur convertit « Meilleure » et « Bonne » pendant le téléchargement. La taille est une limite maximale ; le fichier est généralement plus petit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor convierte “Mejor” y “Buena” mientras se descargan. El tamaño es un límite máximo; el archivo suele quedar más pequeño."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server converte «Migliore» e «Buona» durante il download. La dimensione è un limite massimo; di solito il file risulta più piccolo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Beter’ en ‘Goed’ worden door je server omgezet tijdens het downloaden. De grootte is een bovengrens; meestal wordt het bestand kleiner."
          }
        }
      }
    },
    "Umgerechnete Kopien sind SDR. HDR und Dolby Vision bleiben nur im Original erhalten." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converted copies are SDR. HDR and Dolby Vision are kept only in the original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies converties sont en SDR. Le HDR et le Dolby Vision ne sont conservés que dans l'original."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias convertidas son SDR. HDR y Dolby Vision solo se conservan en el original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie convertite sono in SDR. HDR e Dolby Vision vengono mantenuti solo nell'originale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omgezette kopieën zijn SDR. HDR en Dolby Vision blijven alleen in het origineel behouden."
