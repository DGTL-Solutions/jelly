    "Melde dich bei %@ an. Tipp: Mit der iPhone-Tastatur kannst du gespeicherte Passwörter einsetzen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to %@. Tip: With the iPhone keyboard, you can fill in saved passwords."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi à %@. Astuce : avec le clavier de l'iPhone, tu peux insérer des mots de passe enregistrés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en %@. Consejo: con el teclado del iPhone puedes rellenar las contraseñas guardadas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi a %@. Suggerimento: con la tastiera di iPhone puoi inserire le password salvate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in bij %@. Tip: met het iPhone-toetsenbord kun je bewaarde wachtwoorden invullen."
          }
        }
      }
    },
    "Messung fehlgeschlagen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measurement failed"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la mesure"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La medición ha fallado"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misurazione non riuscita"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meting mislukt"
          }
        }
      }
    },
    "Misst den Weg zu deinem Server und zeigt, was in Originalqualität läuft, was angepasst wird, woran es hakt und zu welcher Tageszeit die Leitung am schnellsten ist." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measures the route to your server and shows what plays in original quality, what gets adjusted, what's holding things back, and at what time of day your connection is fastest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure la connexion à ton serveur et indique ce qui est lu en qualité originale, ce qui est adapté, ce qui pose problème et à quel moment de la journée ta connexion est la plus rapide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide la ruta hasta tu servidor y muestra qué se reproduce en calidad original, qué se ajusta, qué lo está frenando y a qué hora del día es más rápida tu conexión."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura il percorso verso il tuo server e mostra cosa viene riprodotto in qualità originale, cosa viene adattato, cosa frena e in quale momento della giornata la tua connessione è più veloce."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet de route naar je server en toont wat in originele kwaliteit wordt afgespeeld, wat wordt aangepast, wat de boel ophoudt en op welk tijdstip je verbinding het snelst is."
          }
        }
      }
    },
    "Mit Code anmelden" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign In with Code"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecter avec un code"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión con código"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con codice"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met code"
          }
        }
      }
    },
    "Mit Code anmelden: Bestätige die Anmeldung in der Jellyfin-App auf deinem Handy – ganz ohne Tippen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with code: Confirm the sign-in in the Jellyfin app on your phone—no typing needed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecter avec un code : confirme la connexion dans l'app Jellyfin sur ton téléphone, sans rien saisir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión con código: confirma el inicio de sesión en la app Jellyfin de tu teléfono, sin escribir nada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso con codice: conferma l'accesso nell'app Jellyfin sul telefono, senza digitare nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met code: bevestig het inloggen in de Jellyfin-app op je telefoon – zonder te typen."
          }
        }
      }
    },
    "Mit deinem Jellyfin-Konto" : {
