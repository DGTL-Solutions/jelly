    "Dein Jellyfin-Profil darf keine Downloads speichern. Das lässt sich im Jellyfin-Dashboard unter Benutzer › Zugriff ändern." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Jellyfin-profil har ikke tilladelse til at gemme downloads. Det kan ændres i Jellyfin-kontrolpanelet under Brugere › Adgang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Jellyfin profile isn't allowed to save downloads. This can be changed in the Jellyfin dashboard under Users › Access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu perfil de Jellyfin no tiene permiso para guardar descargas. Puede cambiarse en el panel de control de Jellyfin, en Usuarios › Acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
