        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app. Son code source est ouvert, ce qui permet de la recompiler avec des bibliothèques modifiées, comme l'exige la LGPL."
          }
        }
      }
