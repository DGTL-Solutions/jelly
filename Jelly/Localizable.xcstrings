    "Bis zum Ende des Probezeitraums ist alles kostenlos. Danach kostet das Jelly Jahresabo %@ pro Jahr." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is free until your free trial ends. After that, the Jelly Annual Subscription costs %@ per year."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est gratuit jusqu'à la fin de la période d'essai. Ensuite, l'abonnement annuel Jelly coûte %@ par an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo es gratis hasta que termine tu prueba gratuita. Después, la suscripción anual de Jelly cuesta %@ al año."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto è gratuito fino alla fine del periodo di prova. Dopo, l'abbonamento annuale a Jelly costa %@ all'anno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tot het einde van je proefperiode is alles gratis. Daarna kost het Jelly-jaarabonnement %@ per jaar."
          }
        }
      }
    },
