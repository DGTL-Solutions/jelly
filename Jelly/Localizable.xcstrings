    "Beide Werte stammen aus den Metadaten deines Jellyfin-Servers und fehlen bei Titeln, für die der Server keine Bewertung hat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both values come from your Jellyfin server's metadata and are missing for titles the server has no rating for."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux valeurs proviennent des métadonnées de ton serveur Jellyfin et manquent pour les titres que le serveur n'a pas notés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos valores proceden de los metadatos de tu servidor Jellyfin y faltan en los títulos que el servidor no tiene valorados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi i valori provengono dai metadati del tuo server Jellyfin e mancano per i titoli che il server non ha valutato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide waarden komen uit de metadata van je Jellyfin-server en ontbreken bij titels waarvoor de server geen beoordeling heeft."
          }
        }
      }
    },
    "Beim Start nach Profil fragen" : {
      "localizations" : {
