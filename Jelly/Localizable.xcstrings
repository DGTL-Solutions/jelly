    "Prüft den Weg zu %@: Erreichbarkeit, Geschwindigkeit, was davon in deiner Bibliothek im Original läuft und wann die Leitung am schnellsten ist." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerer vejen til %@: tilgængelighed, hastighed, hvor meget af dit bibliotek der afspilles i original kvalitet, og hvornår din forbindelse er hurtigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks the route to %@: reachability, speed, how much of your library plays in original quality, and when your connection is fastest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la ruta hasta %@: accesibilidad, velocidad, qué parte de tu biblioteca se reproduce en calidad original y cuándo es más rápida tu conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie la connexion à %@ : accessibilité, vitesse, part de ta bibliothèque lue en qualité originale et moment où ta connexion est la plus rapide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica il percorso verso %@: raggiungibilità, velocità, quanta parte della tua libreria viene riprodotta in qualità originale e quando la tua connessione è più veloce."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert de route naar %@: bereikbaarheid, snelheid, hoeveel van je bibliotheek in originele kwaliteit wordt afgespeeld en wanneer je verbinding het snelst is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza połączenie z %@: dostępność, prędkość, jaka część twojej biblioteki odtwarza się w oryginalnej jakości i kiedy twoje połączenie jest najszybsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica o caminho até %@: acessibilidade, velocidade, quanto da sua biblioteca é reproduzido em qualidade original e quando a sua conexão é mais rápida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerar vägen till %@: nåbarhet, hastighet, hur mycket av ditt bibliotek som spelas upp i originalkvalitet och när din anslutning är snabbast."
          }
        }
      }
    },
