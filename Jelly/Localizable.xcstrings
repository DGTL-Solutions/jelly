    "Ohne Abo spielt Jelly nichts ab; deine Bibliothek und die Einstellungen bleiben erreichbar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a subscription, Jelly doesn't play anything; your library and settings remain accessible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans abonnement, Jelly ne lit rien ; ta bibliothèque et les réglages restent accessibles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin suscripción, Jelly no reproduce nada; tu biblioteca y tus ajustes siguen accesibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza abbonamento Jelly non riproduce nulla; la tua libreria e le impostazioni restano accessibili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder abonnement speelt Jelly niets af; je bibliotheek en instellingen blijven toegankelijk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem assinatura, o Jelly não reproduz nada; a sua biblioteca e os seus ajustes continuam acessíveis."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden et abonnement afspiller Jelly ikke noget; dit bibliotek og dine indstillinger er stadig tilgængelige."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan prenumeration spelar Jelly inte upp något; ditt bibliotek och dina inställningar är fortfarande tillgängliga."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez subskrypcji Jelly niczego nie odtwarza; twoja biblioteka i ustawienia pozostają dostępne."
          }
        }
      }
    },
