    "Eine Bewertung im App Store hilft anderen, Jelly zu finden. Code mit der Kamera des iPhone scannen – die Seite zum Bewerten öffnet sich direkt." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bedømmelse i App Store hjælper andre med at finde Jelly. Scan koden med kameraet på din iPhone – siden med anmeldelser åbner med det samme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rating in the App Store helps others find Jelly. Scan the code with your iPhone's camera – the review page opens right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una valoración en el App Store ayuda a otras personas a encontrar Jelly. Escanea el código con la cámara de tu iPhone y se abrirá directamente la página de valoración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une note sur l'App Store aide d'autres personnes à découvrir Jelly. Scanne le code avec l'appareil photo de ton iPhone – la page d'évaluation s'ouvre directement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una valutazione nell'App Store aiuta altre persone a scoprire Jelly. Scansiona il codice con la fotocamera di iPhone: la pagina delle recensioni si apre subito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een beoordeling in de App Store helpt anderen Jelly te vinden. Scan de code met de camera van je iPhone – de beoordelingspagina opent meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocena w App Store pomaga innym znaleźć Jelly. Zeskanuj kod aparatem iPhone’a – strona oceny otworzy się od razu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma avaliação na App Store ajuda outras pessoas a encontrar o Jelly. Escaneie o código com a câmera do iPhone – a página de avaliação abre na hora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett betyg i App Store hjälper andra att hitta Jelly. Skanna koden med kameran på din iPhone – recensionssidan öppnas direkt."
          }
        }
      }
    },
    "Eine IP-Adresse oder Domain reicht – Protokoll und Port probiert Jelly automatisch aus." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En IP-adresse eller et domæne er nok – Jelly prøver selv protokol og port."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An IP address or domain is enough—Jelly tries the protocol and port automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta con una dirección IP o un dominio; Jelly prueba el protocolo y el puerto automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse IP ou un domaine suffit – Jelly essaie automatiquement le protocole et le port."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta un indirizzo IP o un dominio: Jelly prova automaticamente protocollo e porta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een IP-adres of domein is genoeg – Jelly probeert het protocol en de poort automatisch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystarczy adres IP lub domena – Jelly samo sprawdzi protokół i port."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta um endereço IP ou domínio – o Jelly testa o protocolo e a porta automaticamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det räcker med en IP-adress eller domän – Jelly provar protokoll och port automatiskt."
