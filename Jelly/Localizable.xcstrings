          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerer vejen til %@: tilgængelighed, hastighed, hvor meget af dit bibliotek der afspilles i original kvalitet, og hvornår din forbindelse er hurtigst."
