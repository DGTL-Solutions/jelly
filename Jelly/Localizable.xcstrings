    "%@ pro Jahr, verlängert sich automatisch – gilt auf iPhone, iPad und Apple TV mit deiner Apple-ID. Kündigen: „Abo verwalten“ oder Einstellungen › dein Name › Abonnements." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per year, renews automatically—applies to iPhone, iPad, and Apple TV using your Apple ID. To cancel: “Manage Subscription” or Settings › your name › Subscriptions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par an, renouvellement automatique – valable sur iPhone, iPad et Apple TV avec ton compte Apple. Pour résilier : « Gérer l'abonnement » ou Réglages › ton nom › Abonnements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al año, con renovación automática; válida en iPhone, iPad y Apple TV con tu cuenta de Apple. Para cancelar: “Gestionar suscripción” o Ajustes › tu nombre › Suscripciones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ all'anno, rinnovo automatico: vale su iPhone, iPad e Apple TV con il tuo Account Apple. Per annullare: «Gestisci abbonamento» oppure Impostazioni › il tuo nome › Abbonamenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per jaar, wordt automatisch verlengd – geldt op iPhone, iPad en Apple TV met je Apple Account. Opzeggen: ‘Beheer abonnement’ of Instellingen › je naam › Abonnementen."
          }
        }
      }
    },
    "%@ pro Jahr, verlängert sich automatisch – gilt auf Apple TV, iPhone und iPad mit deiner Apple-ID. Kündigen: Apple-TV-Einstellungen › Benutzer und Accounts › Abonnements." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per year, renews automatically—applies to Apple TV, iPhone, and iPad using your Apple ID. To cancel: Apple TV Settings › Users and Accounts › Subscriptions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par an, renouvellement automatique – valable sur Apple TV, iPhone et iPad avec ton compte Apple. Pour résilier : Réglages de l'Apple TV › Utilisateurs et comptes › Abonnements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al año, con renovación automática; válida en Apple TV, iPhone y iPad con tu cuenta de Apple. Para cancelar: Ajustes del Apple TV › Usuarios y cuentas › Suscripciones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ all'anno, rinnovo automatico: vale su Apple TV, iPhone e iPad con il tuo Account Apple. Per annullare: Impostazioni di Apple TV › Utenti e account › Abbonamenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per jaar, wordt automatisch verlengd – geldt op Apple TV, iPhone en iPad met je Apple Account. Opzeggen: Apple TV-instellingen › Gebruikers en accounts › Abonnementen."
          }
        }
      }
    },
