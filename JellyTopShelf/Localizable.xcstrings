    "Dafür fehlt deinem Konto die Berechtigung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account doesn't have permission to do this."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte n'a pas l'autorisation de faire cela."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta no tiene permiso para hacer esto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account non ha l'autorizzazione per farlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account heeft hiervoor geen toestemming."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua conta não tem permissão para fazer isso."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din konto har ikke tilladelse til dette."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt konto har inte behörighet att göra detta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto nie ma uprawnień do tej czynności."
          }
        }
      }
    },
    "Der Server hat die Anmeldung abgelehnt. Meist ist das Geräte-Limit deines Kontos erreicht – melde ein anderes Gerät ab oder bitte den Admin, das Limit zu erhöhen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server rejected the sign-in. Usually your account has reached its device limit—sign out another device or ask the admin to raise the limit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la connexion. Le plus souvent, ton compte a atteint sa limite d'appareils – déconnecte un autre appareil ou demande à l'administrateur d'augmenter la limite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha rechazado el inicio de sesión. Normalmente, tu cuenta ha alcanzado su límite de dispositivos: cierra la sesión en otro dispositivo o pide al administrador que aumente el límite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha rifiutato l'accesso. Di solito il tuo account ha raggiunto il limite di dispositivi: esci da un altro dispositivo o chiedi all'amministratore di aumentare il limite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server heeft het inloggen geweigerd. Meestal is de apparaatlimiet van je account bereikt – log uit op een ander apparaat of vraag de beheerder de limiet te verhogen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou o início de sessão. Normalmente, a sua conta atingiu o limite de dispositivos – encerre a sessão em outro dispositivo ou peça ao administrador para aumentar o limite."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren afviste login. Som regel har din konto nået sin grænse for enheder – log ud på en anden enhed, eller bed administratoren om at hæve grænsen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern avvisade inloggningen. Oftast har ditt konto nått sin enhetsgräns – logga ut en annan enhet eller be administratören höja gränsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer odrzucił logowanie. Zwykle oznacza to, że twoje konto osiągnęło limit urządzeń – wyloguj się na innym urządzeniu lub poproś administratora o zwiększenie limitu."
          }
        }
      }
    },
    "Der Server hat mit Fehler %lld geantwortet." : {
      "comment" : "HTTP status code",
      "localizations" : {
