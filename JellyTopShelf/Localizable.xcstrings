      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always software decoder"
          }
        }
      }
    },
    "Klein": {
      "comment": "Subtitle size",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small"
          }
        }
      }
    },
    "Laufend": {
      "comment": "Series status: still airing",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongoing"
          }
        }
      }
    },
    "Neu in deiner Mediathek": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New in Your Library"
          }
        }
      }
    },
    "Noch %@": {
      "comment": "Time left to watch, e.g. Noch 45 Min.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ left"
          }
        }
      }
    },
    "Nächste Folge": {
