      "comment": "HDR10+ with dynamic metadata",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR10+ dynamic"
          }
        }
      }
    },
    "Immer Original (kann stocken)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always original (may stutter)"
          }
        }
      }
    },
