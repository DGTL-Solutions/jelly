      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track %lld"
          }
        }
      }
    },
    "Standard": {
      "comment": "Subtitle size",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default"
          }
        }
      }
    },
    "UT": {
      "comment": "Badge: the title has subtitles",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SUB"
          }
        }
      }
    },
    "Unter dieser Adresse wurde kein Jellyfin-Server gefunden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Jellyfin server was found at this address."
          }
        }
      }
    },
    "Vom Server verpackt": {
      "comment": "Playback engine: stream repackaged by the server",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repackaged by the server"
          }
        }
      }
    },
    "Weiterschauen": {
      "comment": "Continue watching",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue Watching"
          }
        }
      }
    },
    "Weiß": {
      "comment": "Subtitle color",
      "localizations": {
        "en": {
          "stringUnit": {
