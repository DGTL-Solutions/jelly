    "Dafür fehlt deinem Konto die Berechtigung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account doesn't have permission to do this."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte n'a pas l'autorisation de faire cela."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta no tiene permiso para hacer esto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account non ha l'autorizzazione per farlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account heeft hiervoor geen toestemming."
          }
        }
      }
    },
    "Der Server hat die Anmeldung abgelehnt. Meist ist das Geräte-Limit deines Kontos erreicht – melde ein anderes Gerät ab oder bitte den Admin, das Limit zu erhöhen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server rejected the sign-in. Usually your account has reached its device limit—sign out another device or ask the admin to raise the limit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la connexion. Le plus souvent, ton compte a atteint sa limite d'appareils – déconnecte un autre appareil ou demande à l'administrateur d'augmenter la limite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha rechazado el inicio de sesión. Normalmente, tu cuenta ha alcanzado su límite de dispositivos: cierra la sesión en otro dispositivo o pide al administrador que aumente el límite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha rifiutato l'accesso. Di solito il tuo account ha raggiunto il limite di dispositivi: esci da un altro dispositivo o chiedi all'amministratore di aumentare il limite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server heeft het inloggen geweigerd. Meestal is de apparaatlimiet van je account bereikt – log uit op een ander apparaat of vraag de beheerder de limiet te verhogen."
          }
        }
      }
    },
    "Der Server hat mit Fehler %lld geantwortet." : {
      "comment" : "HTTP status code",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server responded with error %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a répondu avec l'erreur %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha respondido con el error %lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha risposto con l'errore %lld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server antwoordde met fout %lld."
          }
        }
      }
    },
    "Die Anmeldung konnte nicht sicher gespeichert werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in couldn't be stored securely."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'enregistrer la connexion de manière sécurisée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar tu sesión de forma segura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare l'accesso in modo sicuro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je inlog kan niet veilig worden bewaard."
          }
        }
      }
    },
    "Diese Adresse sieht nicht richtig aus. Beispiel: 192.168.1.20 oder jellyfin.meinedomain.de" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
