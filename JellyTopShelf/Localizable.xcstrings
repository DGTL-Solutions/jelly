      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next Episode"
          }
        }
      }
    },
    "Original ohne ungenutzte Tonspuren · verlustfrei": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original without unused audio tracks · lossless"
          }
        }
      }
    },
    "Originaldatei": {
      "comment": "Playback engine: the original file plays unchanged",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original file"
          }
        }
      }
    },
    "Quick Connect ist auf diesem Server deaktiviert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick Connect is turned off on this server."
          }
        }
      }
    },
    "S%lld": {
      "comment": "Season number (S = Staffel)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "S%lld"
          }
        }
      }
    },
    "S%lld · F%lld": {
      "comment": "Season and episode number, e.g. S1 · F3 (S = Staffel, F = Folge)",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "S%1$lld · F%2$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "S%lld · E%lld"
          }
        }
      }
    },
    "Schatten": {
