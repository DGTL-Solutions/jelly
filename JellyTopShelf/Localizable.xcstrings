    "Die Anmeldung konnte nicht sicher gespeichert werden." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in couldn't be stored securely."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'enregistrer la connexion de manière sécurisée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar tu sesión de forma segura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare l'accesso in modo sicuro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je inlog kan niet veilig worden bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível armazenar a sua sessão com segurança."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit login kunne ikke gemmes sikkert."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din inloggning kunde inte sparas säkert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się bezpiecznie zapisać danych logowania."
          }
        }
      }
